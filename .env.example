# Copie para .env.local. Sem estas chaves o convite visual funciona,
# mas o RSVP e o admin avisam que o setup ainda está pendente.
# Nunca use a service role no cliente. Nada de senha padrão no código.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatível com projetos que ainda usam a chave anon:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apenas server-side. Nunca prefixe com NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Origem pública para links pessoais e .ics
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Código de acesso do painel /admin (apenas server-side)
ADMIN_ACCESS_CODE=
